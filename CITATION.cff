    given-names: Thomas
    affiliation: "Faculty of Engineering, Bar-Ilan University, Ramat Gan, Israel"
  - family-names: Yaari
    given-names: Gur
    affiliation: "Department of Pathology, Yale School of Medicine, New Haven, CT, USA"
