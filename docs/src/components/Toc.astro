---
/**
 * "On this page", drawn as a path through the page: a rail that fills up to
 * the section being read, a dot per section (read, current, still ahead) and
 * a ring showing how much of the page has been read. Starlight's own table of
 * contents does the work, including which section is current; this adds the
 * drawing. Replaces Starlight's TableOfContents slot.
 */
import Default from '@astrojs/starlight/components/TableOfContents.astro';
---

<div class="beam-toc">
	<div class="beam-toc-ring" aria-hidden="true" title="Read so far">
		<svg viewBox="0 0 36 36">
			<circle class="track" cx="18" cy="18" r="15.5"></circle>
			<circle class="fill" cx="18" cy="18" r="15.5" pathLength="100"></circle>
		</svg>
		<span class="pct">0%</span>
	</div>
	<Default />
</div>

<script>
	function setUp(root: HTMLElement) {
		const list = root.querySelector<HTMLUListElement>('nav > ul');
		const ring = root.querySelector<HTMLElement>('.beam-toc-ring');
		if (!list || !ring) return;
		const fill = document.createElement('span');
		fill.className = 'beam-toc-fill';
		fill.setAttribute('aria-hidden', 'true');
		list.prepend(fill);
		const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
		const toc = root.querySelector('starlight-toc') as (HTMLElement & { current?: HTMLAnchorElement }) | null;

		// The rail fills down to the current section's dot; sections above it are read.
		const mark = () => {
			// A last section too short to reach the top of the window never becomes
			// current on its own; at the bottom of the page it is the one being
			// read. Set through Starlight's own setter so its record stays right.
			const atEnd = window.scrollY > 0 &&
				window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
			const last = links[links.length - 1];
			if (atEnd && toc && last && last.getAttribute('aria-current') !== 'true') {
				toc.current = last;          // its mutation calls mark again
				return;
			}
			const current = links.findIndex((a) => a.getAttribute('aria-current') === 'true');
			links.forEach((a, i) => a.classList.toggle('read', current >= 0 && i < current));
			const a = links[current];
			const top = list.getBoundingClientRect().top;
			const y = a ? a.getBoundingClientRect().top - top + a.offsetHeight / 2 : 0;
			fill.style.height = `${Math.max(0, y)}px`;
		};
		new MutationObserver(mark).observe(list, { attributes: true, subtree: true, attributeFilter: ['aria-current'] });

		const pct = ring.querySelector<HTMLElement>('.pct')!;
		const arc = ring.querySelector<SVGCircleElement>('.fill')!;
		let queued = false;
		const read = () => {
			const span = document.documentElement.scrollHeight - window.innerHeight;
			const p = span > 0 ? Math.min(1, Math.max(0, window.scrollY / span)) : 1;
			arc.style.strokeDasharray = `${(p * 100).toFixed(1)} 100`;
			pct.textContent = `${Math.round(p * 100)}%`;
		};
		window.addEventListener('scroll', () => {
			read();
			if (!queued) {
				queued = true;
				requestAnimationFrame(() => ((queued = false), mark()));
			}
		}, { passive: true });
		window.addEventListener('resize', () => (read(), mark()));
		read();
		mark();
	}
	document.querySelectorAll<HTMLElement>('.beam-toc').forEach(setUp);
</script>

<style>
	.beam-toc {
		position: relative;
		--rail-x: 0.4rem;
		--dot: 9px;
	}

	/* Reading progress, beside the "On this page" heading. */
	.beam-toc-ring {
		position: absolute;
		top: 0.05rem;
		right: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--sl-text-2xs);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}
	.beam-toc-ring svg {
		width: 1.1rem;
		height: 1.1rem;
		transform: rotate(-90deg);
	}
	.beam-toc-ring circle {
		fill: none;
		stroke-width: 4;
	}
	.beam-toc-ring .track {
		stroke: var(--sl-color-gray-6);
	}
	.beam-toc-ring .fill {
		stroke: var(--sl-color-text-accent);
		stroke-linecap: round;
		stroke-dasharray: 0 100;
		transition: stroke-dasharray 0.15s linear;
	}

	/* The rail, and its filled part. */
	.beam-toc :global(nav > ul) {
		position: relative;
		padding-inline-start: 1.1rem;
	}
	.beam-toc :global(nav > ul)::before,
	.beam-toc :global(.beam-toc-fill) {
		content: '';
		position: absolute;
		left: var(--rail-x);
		top: 0;
		width: 2px;
		border-radius: 2px;
	}
	.beam-toc :global(nav > ul)::before {
		bottom: 0;
		background: var(--sl-color-gray-6);
	}
	.beam-toc :global(.beam-toc-fill) {
		height: 0;
		background: linear-gradient(to bottom, var(--sl-color-accent-low), var(--sl-color-text-accent));
		transition: height 0.3s ease;
		z-index: 1;
	}

	/* Section titles, and a dot on the rail for each top-level one. */
	.beam-toc :global(nav > ul > li) {
		position: relative;
	}
	.beam-toc :global(nav a) {
		color: var(--sl-color-gray-3);
		transition: color 0.2s ease;
	}
	.beam-toc :global(nav a:hover) {
		color: var(--sl-color-white);
	}
	.beam-toc :global(nav a.read) {
		color: var(--sl-color-gray-2);
	}
	.beam-toc :global(nav a[aria-current='true']) {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	.beam-toc :global(nav > ul > li > a)::before {
		content: '';
		position: absolute;
		left: calc(var(--rail-x) + 1px - var(--dot) / 2 - 1.1rem);
		top: calc(0.25rem + 0.625em - var(--dot) / 2);
		width: var(--dot);
		height: var(--dot);
		box-sizing: border-box;
		border-radius: 50%;
		border: 2px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-sidebar, var(--sl-color-bg));
		z-index: 2;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}
	.beam-toc :global(nav > ul > li > a:hover)::before {
		transform: scale(1.25);
	}
	.beam-toc :global(nav > ul > li > a.read)::before {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-accent-low);
	}
	.beam-toc :global(nav > ul > li > a[aria-current='true'])::before {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-text-accent);
		box-shadow: 0 0 0 4px var(--sl-color-accent-low);
	}

	/* Subsections: indented, smaller, no dot. */
	.beam-toc :global(nav ul ul a) {
		font-size: var(--sl-text-xs);
	}

	@media (prefers-reduced-motion: reduce) {
		.beam-toc :global(.beam-toc-fill),
		.beam-toc :global(nav a),
		.beam-toc :global(nav a)::before,
		.beam-toc-ring .fill {
			transition: none;
		}
	}
</style>
